# 돛단배 환경 변수 — 복사해서 .env 로 만들고 값을 채우세요.

# Supabase 프로젝트 (대시보드 > Project Settings > API)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# 앱인토스 콘솔 > 수익화 > 인앱광고에서 광고 유형별로 발급한 광고 그룹 ID.
# 비워두면 해당 광고는 표시되지 않아요(보상형은 즉시 통과해 개발/브라우저에서도 흐름이 안 끊겨요).
VITE_AD_GROUP_ID_BANNER=
VITE_AD_GROUP_ID_INTERSTITIAL=
VITE_AD_GROUP_ID_REWARDED=
# (구버전 호환) VITE_AD_GROUP_ID 는 보상형 폴백으로만 쓰여요. 위 _REWARDED 사용을 권장해요.
VITE_AD_GROUP_ID=

# 앱인토스 콘솔 > 스마트 발송에서 발급한 알림 동의 템플릿 코드 (비워두면 알림 동의 요청 건너뜀)
VITE_NOTIFY_TEMPLATE_CODE=
